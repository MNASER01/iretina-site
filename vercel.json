{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/ios", "destination": "/api/go?p=ios&c=direct" },
    { "source": "/mac", "destination": "/" },
    { "source": "/unsubscribe", "destination": "/api/unsubscribe" },
    { "source": "/:campaign/ios", "destination": "/api/go?p=ios&c=:campaign" },
    { "source": "/:campaign/mac", "destination": "/" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
